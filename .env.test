# Test groups. Set these in your shell (not here). TESTDEST ⊂ TESTCOMPAT: each
# row adds to the rows above it and needs more services. TESTAZURE is separate.
#
#   flag            runs                                         services
#   (none)          everything the default dev setup uses:       make up/test
#                   ClickHouse, Postgres, Redis/Dragonfly,
#                   NATS internal queue, e2e
#   TESTDEST=1      + destination providers (RabbitMQ, AWS,      + make up/dest
#                   GCP Pub/Sub, Kafka)
#   TESTCOMPAT=1    + Outpost on the other internal queues       + make up/dest
#                   (RabbitMQ, SQS, Pub/Sub), backend compat
#                   suites; includes TESTDEST
#
#   TESTAZURE=1     separate: Azure Service Bus tests only       Azure emulator
#                                                                (LOCAL_DEV_AZURE=1 make up)
#
# TESTINFRA=1 makes the tests use the endpoints below instead of starting
# containers themselves. See contributing/test.md.

# Test stack (make up/test)
TEST_POSTGRES_URL="localhost:35432"
TEST_CLICKHOUSE_URL="localhost:39000"
TEST_NATS_URL="localhost:34222"
TEST_MOCKSERVER_URL="localhost:35555"
# Destination stack (make up/dest); Kafka on its SASL listener
TEST_RABBITMQ_URL="localhost:15672"
TEST_KAFKA_URL="localhost:19093"
TEST_LOCALSTACK_URL="localhost:14566"
TEST_GCP_URL="localhost:18085"
# Azure Service Bus emulator of the dev stack (LOCAL_DEV_AZURE=1 make up)
TEST_AZURE_SB_CONNSTRING="Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"

# Container images
#
# Both ways of providing test infrastructure read these: the compose stack
# (started by `make up/test`, which passes this file as --env-file) and the
# containers the tests start themselves when TESTINFRA is unset. Keeping them
# here is what makes the two the same environment.
#
# Pin exact versions. Floating tags have broken this suite before: an image
# published a new major under the same tag and every test that needed it failed
# on a change nobody made.
TEST_IMAGE_POSTGRES="postgres:16.10-alpine"
TEST_IMAGE_CLICKHOUSE="clickhouse/clickhouse-server:24.10-alpine"
TEST_IMAGE_RABBITMQ="rabbitmq:3.13-management"
TEST_IMAGE_NATS="nats:2.10-alpine"
TEST_IMAGE_KAFKA="confluentinc/confluent-local:7.4.0"
TEST_IMAGE_LOCALSTACK="localstack/localstack:3.8.1"
TEST_IMAGE_GCP="gcr.io/google.com/cloudsdktool/google-cloud-cli:544.0.0-emulators"
TEST_IMAGE_REDIS="redis/redis-stack-server:7.4.0-v3"
TEST_IMAGE_DRAGONFLY="docker.dragonflydb.io/dragonflydb/dragonfly:v1.38.1"
