# Outpost Configuration Example
# This is a comprehensive list of available configuration options.
# While all options can be configured here, it is recommended to use environment variables
# for sensitive values (secrets, credentials, API keys, etc.) instead of storing them in this file.
# Each configuration option can be overridden by its corresponding environment variable.

# Service
service: "" # Service type: "", "api", "log", "delivery" (empty string for singular mode that runs all services)

# Infrastructure Configuration
## Redis
redis:
  host: "127.0.0.1" # Default Redis host
  port: 6379 # Default Redis port
  password: "" # Redis password
  database: 0 # Redis database number

## ClickHouse
clickhouse:
  addr: "" # ClickHouse address (e.g., localhost:9000)
  username: "" # ClickHouse username
  password: "" # ClickHouse password
  database: "outpost" # Default database name

## Message Queue
mqs:
  # Configure one provider only

  # RabbitMQ Configuration Example
  rabbitmq:
    server_url: "amqp://user:pass@localhost:5672" # RabbitMQ server URL with credentials
    exchange: "outpost" # Exchange name for message routing
    delivery_queue: "outpost-delivery" # Queue for delivery events
    log_queue: "outpost-log" # Queue for log events

  # AWS SQS Configuration Example
  aws_sqs:
    access_key_id: "YOUR_AWS_ACCESS_KEY" # AWS access key ID
    secret_access_key: "YOUR_AWS_SECRET_KEY" # AWS secret access key
    region: "us-west-2" # AWS region
    endpoint: "https://sqs.us-west-2.amazonaws.com" # SQS endpoint (optional, for custom endpoints)
    delivery_queue: "outpost-delivery" # SQS queue name for delivery events
    log_queue: "outpost-log" # SQS queue name for log events

  # NATS JetStream Configuration Example
  nats:
    server_url: "nats://localhost:4222" # NATS server URL
    stream: "outpost" # JetStream stream name
    delivery_subject: "outpost.delivery" # Subject for delivery events (must start with "<stream>.")
    log_subject: "outpost.log" # Subject for log events (must start with "<stream>.")

# Application Configuration
aes_encryption_secret: "" # Secret for AES encryption
topics: # List of topics to subscribe to
  - user.created
  - user.updated
  - user.deleted

## Topic Schemas
# Loaded by the API service at startup. Set topics_schemas or topics_schemas_file, not both.
# topics_schemas: # Keyed by topic name; every key must be in topics
#   user.created:
#     description: "A user signed up."
#     validation: warn # off (default), warn or enforce
#     mcp:
#       enabled: false
#     payload_schema: # JSON Schema 2020-12 for the event data
#       type: object
#       properties:
#         user_id: { type: string }
#       required: [user_id]
# topics_schemas_file: "config/outpost/topics-schemas.yaml" # YAML or JSON file with the same content
# topics_schemas_openapi: "config/outpost/openapi.yaml" # OpenAPI 3.1 document (file path or URL) whose webhooks provide schemas
# topics_schemas_openapi_sha256: "" # Hex SHA-256 pin for the OpenAPI document
# topics_validation_max_bytes: 262144 # Largest event data validated against its topic schema; validation takes roughly 20-350x this in memory, plus ~80x per anyOf/oneOf branch the data fails
# topics_allow_breaking_changes: false # Apply schema changes that break live MCP subscriptions, ending them. One deploy only.

## MCP Events
# Takes effect once a topic has mcp.enabled set. Set the same values on every service.
# Durations take Go duration strings (90s, 5m, 24h) or seconds.
# mcp:
#   server_url: "https://mcp.example.com/mcp" # Public URL of your MCP server, shown in the portal's setup instructions
#   callback_allowlist: [localhost] # IPs/CIDRs exempt from the callback address check. Development only
#   allow_insecure_callbacks: false # Allow http callbacks to allowlisted non-loopback addresses. Development only
#   proxy_url: "" # Forward proxy for MCP deliveries, challenges and terminated envelopes
#   verification_ttl: 24h # How long a passed callback challenge is cached
#   verification_rate_limit: 10 # Challenges per tenant and principal per minute
#   verification_failure_limit: 120 # Failed challenges per callback host per minute
#   secret_rotation_grace: 24h # How long the previous secret keeps signing after a rotation
#   ttl_default: 1h # Lifetime granted when the client suggests none
#   ttl_min: 5m
#   ttl_max: 24h
#   allow_no_expiry: false # Grant no expiry when a client asks for it
#   retry_schedule: [30, 120, 600] # Retry delays in seconds
#   error_codes: sketch # sketch or sep-3415
#   send_terminated: true # Send terminated envelopes when Outpost ends a subscription
#   expiry_sweep_interval: 30s # How often expired subscriptions are deleted
#   max_inflight_per_host: 8 # Attempts in flight per callback host, per process
# max_mcp_subscriptions_per_tenant: 100 # MCP subscriptions per tenant, separate from max_destinations_per_tenant
# max_mcp_subscriptions_per_principal: 20 # MCP subscriptions per principal within a tenant (0 = no limit)

## API
api_port: 3333 # Default port for the API server
api_key: "" # API key for authentication
api_jwt_secret: "" # JWT secret for authentication

## Delivery
max_destinations_per_tenant: 20 # Maximum destinations per tenant
delivery_timeout_seconds: 5 # Timeout for delivery operations

## Event Delivery Retry
retry_interval_seconds: 30 # Interval between event delivery retries
retry_max_limit: 10 # Maximum number of event delivery retries

## Consumer Settings
publish_max_concurrency: 1 # Max number of publish messages to process concurrently
publish_max_redeliveries: -1 # Max redeliveries of a failed publish message before Outpost stops redelivering it (-1 = unlimited, 0 = none)
delivery_max_concurrency: 1 # Max number of delivery messages to process concurrently
log_max_concurrency: 1 # Max number of log messages to process concurrently

## Supervisor
# Restart queue workers that fail instead of reporting them failed at once. Off by default.
# supervisor:
#   restart_workers: [publishmq, deliverymq, logmq, retrymq]

## Log Batcher
log_batch_threshold_seconds: 10 # Time to wait before sending a batch of logs (env: LOG_BATCH_THRESHOLD_SECONDS)
log_batch_size: 1000 # Maximum number of logs to include in a batch (env: LOG_BATCH_SIZE)

## Portal
portal:
  organization_name: "Acme" # Organization name
  referer_url: "https://example.com" # Portal referer URL
  favicon_url: "https://example.com/favicon.svg" # Portal favicon URL
  brand_color: "#6122E7" # Portal brand color
  # logo: "https://example.com" # Portal logo URL
  #logo_dark: "https://example.com" # Portal logo URL for dark mode
  # show_mcp_destinations: true # Show MCP Events subscriptions and setup instructions

# Destinations Configuration
destinations:
  metadata_path: "config/outpost/destinations" # Path to destination metadata
  # proxy_url: "http://user:pass@proxy:10000" # Forward proxy for webhook, RabbitMQ and Kafka destinations (MCP uses mcp.proxy_url)
  # aws_eventbridge:
  #   source: "outpost" # EventBridge Source set on every event
  webhook:
    header_prefix: "x-custom-" # Prefix for webhook headers
    # disable_default_event_id_header
    # disable_default_signature_header
    # disable_default_timestamp_header
    # disable_default_topic_header
    # signature_content_template: {{.Timestamp.UnixMilli}}.{{.Body}}
    # signature_header_template: t={{.Timestamp.UnixMilli}},v0={{.Signatures | join ","}}
    # signature_encoding: hex
    # signature_algorithm: hmac-sha256

# Note: OpenTelemetry Configuration
# It is recommended to configure OpenTelemetry using environment variables as they are better supported by the SDK.
# Example environment variables:
# - OTEL_SERVICE_NAME: Service name (if provided, OpenTelemetry will be enabled)
# - OTEL_EXPORTER_OTLP_ENDPOINT: OpenTelemetry collector endpoint
# - OTEL_EXPORTER_OTLP_PROTOCOL: Protocol (grpc or http)
