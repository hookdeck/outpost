          "id": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "examples": [
          {
            "id": "inc_1042",
            "service": "checkout",
            "resolved_at": "2026-10-31T15:42:00Z"
          }
        ]
      }
    },
    {
