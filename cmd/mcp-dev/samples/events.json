{
  "events": [
    {
      "name": "incident.created",
      "description": "An incident was opened.",
      "delivery": [
        "webhook"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "service": {
            "type": "string"
          }
        }
      },
      "payloadSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "title": {
            "type": "string"
          },
          "opened_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "examples": [
          {
            "id": "inc_1042",
            "service": "checkout",
            "severity": "P1",
            "title": "Checkout error rate above 5%",
            "opened_at": "2026-10-31T15:04:05Z"
          }
        ]
      }
    },
    {
      "name": "incident.resolved",
