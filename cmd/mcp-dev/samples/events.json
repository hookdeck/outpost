          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid"
            ]
          }
        },
        "examples": [
          {
            "id": "ord_881",
            "customer_id": "cus_17",
            "amount": 4200,
            "currency": "usd",
