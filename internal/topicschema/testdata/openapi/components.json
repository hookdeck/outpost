{
  "openapi": "3.1.0",
  "info": {
    "title": "Acme Store webhooks",
    "version": "2026.10.0"
  },
  "webhooks": {
    "orderCreated": {
      "post": {
        "x-outpost-topic": "order.created",
        "summary": "An order was placed.",
        "description": "Sent once per order, after payment authorization.",
        "x-mcp-enabled": true,
        "requestBody": {
          "$ref": "#/components/requestBodies/OrderCreated"
        },
        "responses": {
          "200": {
            "description": "Received."
          }
        }
      }
    },
    "order.updated": {
      "post": {
        "description": "An order changed.",
        "requestBody": {
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "type": "object",
                "$defs": {
                  "Money": {
                    "type": "string",
                    "description": "Display string for an amount, such as \"$12.00\"."
                  }
                },
                "properties": {
                  "order": {
                    "$ref": "#/components/schemas/OrderEvent"
                  },
                  "previousTotal": {
                    "$ref": "#/components/schemas/Money"
                  },
                  "displayTotal": {
                    "$ref": "#/$defs/Money"
                  },
                  "changedFields": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "status",
                        "total",
                        "items",
                        "customer"
                      ]
                    }
                  },
                  "updatedOn": {
                    "type": "string",
                    "format": "date",
                    "default": "2026-10-09"
                  }
                },
                "required": [
                  "order",
                  "changedFields"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Received."
          }
        }
      }
    },
    "refund.created": {
      "$ref": "#/components/pathItems/RefundCreated"
    },
    "payment.succeeded": {
      "post": {
        "summary": "A payment succeeded.",
        "x-mcp-enabled": true,
        "deprecated": true,
        "requestBody": {
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            },
            "application/cloudevents+json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentSucceeded",
                "description": "The payment, with its method."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Received."
          }
        }
      }
    },
    "customerDeleted": {
      "post": {
        "summary": "A customer was deleted.",
        "responses": {
          "200": {
            "description": "Received."
          }
        }
      }
    },
    "invoice.rendered": {
      "post": {
        "summary": "An invoice PDF was rendered.",
        "requestBody": {
          "content": {
            "application/pdf": {
              "schema": {
                "type": "string",
                "contentEncoding": "base64"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Received."
          }
        }
      }
    },
    "status.ping": {
      "get": {
        "summary": "Health probe.",
        "responses": {
          "200": {
            "description": "OK."
          }
        }
      }
    }
  },
  "components": {
    "requestBodies": {
      "OrderCreated": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Order"
            }
          }
        }
      }
    },
    "pathItems": {
      "RefundCreated": {
        "x-outpost-topic": "refund.issued",
        "post": {
          "summary": "A refund was issued.",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refund"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Received."
            }
          }
        }
      }
    },
    "schemas": {
      "Currency": {
        "type": "string",
        "description": "ISO 4217 currency code.",
        "enum": [
          "USD",
          "EUR",
          "CAD"
        ]
      },
      "Money": {
        "type": "object",
        "description": "An amount in a currency.",
        "properties": {
          "amount": {
            "type": "integer",
            "description": "Amount in minor units.",
            "minimum": 0,
            "maximum": 9007199254740993
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          }
        },
        "required": [
          "amount",
          "currency"
        ]
      },
      "Address": {
        "type": "object",
        "properties": {
          "line1": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "postalCode": {
            "type": "string"
          }
        }
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "x-mcp-filter": false
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "shippingAddress": {
            "$ref": "#/components/schemas/Address"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id"
        ]
      },
      "OrderStatus": {
        "type": "string",
        "description": "Lifecycle state of the order.",
        "enum": [
          "pending",
          "paid",
          "shipped",
          "cancelled"
        ]
      },
      "LineItem": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "sku",
          "quantity",
          "unitPrice"
        ]
      },
      "MetadataValue": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "Order": {
        "type": "object",
        "description": "An order placed in the store.",
        "properties": {
          "orderId": {
            "type": "string",
            "x-mcp-filter": false
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/LineItem"
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/MetadataValue"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "x-mcp-filter": false,
            "examples": [
              "2026-10-09T16:58:12Z"
            ]
          },
          "channel": {
            "const": "web",
            "examples": [
              {
                "$ref": "#/components/schemas/Order"
              }
            ]
          }
        },
        "required": [
          "orderId",
          "status",
          "total",
          "customer",
          "items"
        ]
      },
      "OrderEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Order"
          },
          {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Refund": {
        "type": "object",
        "properties": {
          "refundId": {
            "type": "string",
            "x-mcp-filter": false
          },
          "orderId": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "reason": {
            "type": "string",
            "enum": [
              "duplicate",
              "fraudulent",
              "requested_by_customer"
            ]
          },
          "lineItemSku": {
            "$ref": "#/components/schemas/LineItem/properties/sku"
          }
        },
        "required": [
          "refundId",
          "orderId",
          "amount"
        ]
      },
      "Card": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "card"
          },
          "last4": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          }
        },
        "required": [
          "kind",
          "last4"
        ]
      },
      "BankTransfer": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "bank_transfer"
          },
          "iban": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ]
      },
      "PaymentMethod": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Card"
          },
          {
            "$ref": "#/components/schemas/BankTransfer"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "card": "#/components/schemas/Card",
            "bank_transfer": "BankTransfer"
          }
        }
      },
      "PaymentSucceeded": {
        "type": "object",
        "description": "A successful payment.",
        "properties": {
          "paymentId": {
            "type": "string",
            "x-mcp-filter": false
          },
          "orderId": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "method": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "succeededAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "paymentId",
          "amount",
          "method"
        ]
      },
      "Unused": {
        "type": "object",
        "properties": {
          "ignored": {
            "$ref": "./unused.yaml"
          }
        }
      }
    }
  }
}
