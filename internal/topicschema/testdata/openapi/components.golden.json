{
  "order.created": {
    "description": "An order was placed.",
    "payload_schema": {
      "type": "object",
      "description": "An order placed in the store.",
      "properties": {
        "orderId": {
          "type": "string",
          "x-mcp-filter": false
        },
        "status": {
          "$ref": "#/$defs/OrderStatus"
        },
        "total": {
          "$ref": "#/$defs/Money"
        },
        "customer": {
          "$ref": "#/$defs/Customer"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/LineItem"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/MetadataValue"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "x-mcp-filter": false,
          "examples": [
            "2026-10-09T16:58:12Z"
          ]
        },
        "channel": {
          "const": "web",
          "examples": [
            {
              "$ref": "#/components/schemas/Order"
            }
          ]
        }
      },
      "required": [
        "orderId",
        "status",
        "total",
        "customer",
        "items"
      ],
      "$defs": {
        "OrderStatus": {
          "type": "string",
          "description": "Lifecycle state of the order.",
          "enum": [
            "pending",
            "paid",
            "shipped",
            "cancelled"
          ]
        },
        "Money": {
          "type": "object",
          "description": "An amount in a currency.",
          "properties": {
            "amount": {
              "type": "integer",
              "description": "Amount in minor units.",
              "minimum": 0,
              "maximum": 9007199254740993
            },
            "currency": {
              "$ref": "#/$defs/Currency"
            }
          },
          "required": [
            "amount",
            "currency"
          ]
        },
        "Customer": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "x-mcp-filter": false
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "shippingAddress": {
              "$ref": "#/$defs/Address"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id"
          ]
        },
        "LineItem": {
          "type": "object",
          "properties": {
            "sku": {
              "type": "string"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            },
            "unitPrice": {
              "$ref": "#/$defs/Money"
            }
          },
          "required": [
            "sku",
            "quantity",
            "unitPrice"
          ]
        },
        "MetadataValue": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "Currency": {
          "type": "string",
          "description": "ISO 4217 currency code.",
          "enum": [
            "USD",
            "EUR",
            "CAD"
          ]
        },
        "Address": {
          "type": "object",
          "properties": {
            "line1": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "postalCode": {
              "type": "string"
            }
          }
        }
      }
    },
    "mcp": {
      "enabled": true
    }
  },
  "order.updated": {
    "description": "An order changed.",
    "payload_schema": {
      "type": "object",
      "$defs": {
        "Money": {
          "type": "string",
          "description": "Display string for an amount, such as \"$12.00\"."
        },
        "OrderEvent": {
          "allOf": [
            {
              "$ref": "#/$defs/Order"
            },
            {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "Money_2": {
          "type": "object",
          "description": "An amount in a currency.",
          "properties": {
            "amount": {
              "type": "integer",
              "description": "Amount in minor units.",
              "minimum": 0,
              "maximum": 9007199254740993
            },
            "currency": {
              "$ref": "#/$defs/Currency"
            }
          },
          "required": [
            "amount",
            "currency"
          ]
        },
        "Order": {
          "type": "object",
          "description": "An order placed in the store.",
          "properties": {
            "orderId": {
              "type": "string",
              "x-mcp-filter": false
            },
            "status": {
              "$ref": "#/$defs/OrderStatus"
            },
            "total": {
              "$ref": "#/$defs/Money_2"
            },
            "customer": {
              "$ref": "#/$defs/Customer"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/LineItem"
              }
            },
            "metadata": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/MetadataValue"
              }
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "x-mcp-filter": false,
              "examples": [
                "2026-10-09T16:58:12Z"
              ]
            },
            "channel": {
              "const": "web",
              "examples": [
                {
                  "$ref": "#/components/schemas/Order"
                }
              ]
            }
          },
          "required": [
            "orderId",
            "status",
            "total",
            "customer",
            "items"
          ]
        },
        "Currency": {
          "type": "string",
          "description": "ISO 4217 currency code.",
          "enum": [
            "USD",
            "EUR",
            "CAD"
          ]
        },
        "OrderStatus": {
          "type": "string",
          "description": "Lifecycle state of the order.",
          "enum": [
            "pending",
            "paid",
            "shipped",
            "cancelled"
          ]
        },
        "Customer": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "x-mcp-filter": false
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "shippingAddress": {
              "$ref": "#/$defs/Address"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id"
          ]
        },
        "LineItem": {
          "type": "object",
          "properties": {
            "sku": {
              "type": "string"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            },
            "unitPrice": {
              "$ref": "#/$defs/Money_2"
            }
          },
          "required": [
            "sku",
            "quantity",
            "unitPrice"
          ]
        },
        "MetadataValue": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "Address": {
          "type": "object",
          "properties": {
            "line1": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "postalCode": {
              "type": "string"
            }
          }
        }
      },
      "properties": {
        "order": {
          "$ref": "#/$defs/OrderEvent"
        },
        "previousTotal": {
          "$ref": "#/$defs/Money_2"
        },
        "displayTotal": {
          "$ref": "#/$defs/Money"
        },
        "changedFields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "status",
              "total",
              "items",
              "customer"
            ]
          }
        },
        "updatedOn": {
          "type": "string",
          "format": "date",
          "default": "2026-10-09"
        }
      },
      "required": [
        "order",
        "changedFields"
      ]
    },
    "mcp": {
      "enabled": false
    }
  },
  "payment.succeeded": {
    "description": "A payment succeeded.",
    "payload_schema": {
      "type": "object",
      "description": "The payment, with its method.",
      "properties": {
        "paymentId": {
          "type": "string",
          "x-mcp-filter": false
        },
        "orderId": {
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "method": {
          "$ref": "#/$defs/PaymentMethod"
        },
        "succeededAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "paymentId",
        "amount",
        "method"
      ],
      "$defs": {
        "Money": {
          "type": "object",
          "description": "An amount in a currency.",
          "properties": {
            "amount": {
              "type": "integer",
              "description": "Amount in minor units.",
              "minimum": 0,
              "maximum": 9007199254740993
            },
            "currency": {
              "$ref": "#/$defs/Currency"
            }
          },
          "required": [
            "amount",
            "currency"
          ]
        },
        "PaymentMethod": {
          "oneOf": [
            {
              "$ref": "#/$defs/Card"
            },
            {
              "$ref": "#/$defs/BankTransfer"
            }
          ],
          "discriminator": {
            "propertyName": "kind",
            "mapping": {
              "card": "#/$defs/Card",
              "bank_transfer": "BankTransfer"
            }
          }
        },
        "Currency": {
          "type": "string",
          "description": "ISO 4217 currency code.",
          "enum": [
            "USD",
            "EUR",
            "CAD"
          ]
        },
        "Card": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "card"
            },
            "last4": {
              "type": "string",
              "pattern": "^[0-9]{4}$"
            }
          },
          "required": [
            "kind",
            "last4"
          ]
        },
        "BankTransfer": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bank_transfer"
            },
            "iban": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        }
      }
    },
    "mcp": {
      "enabled": true
    },
    "deprecated": true
  },
  "refund.issued": {
    "description": "A refund was issued.",
    "payload_schema": {
      "type": "object",
      "properties": {
        "refundId": {
          "type": "string",
          "x-mcp-filter": false
        },
        "orderId": {
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "reason": {
          "type": "string",
          "enum": [
            "duplicate",
            "fraudulent",
            "requested_by_customer"
          ]
        },
        "lineItemSku": {
          "$ref": "#/$defs/LineItem/properties/sku"
        }
      },
      "required": [
        "refundId",
        "orderId",
        "amount"
      ],
      "$defs": {
        "Money": {
          "type": "object",
          "description": "An amount in a currency.",
          "properties": {
            "amount": {
              "type": "integer",
              "description": "Amount in minor units.",
              "minimum": 0,
              "maximum": 9007199254740993
            },
            "currency": {
              "$ref": "#/$defs/Currency"
            }
          },
          "required": [
            "amount",
            "currency"
          ]
        },
        "LineItem": {
          "type": "object",
          "properties": {
            "sku": {
              "type": "string"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            },
            "unitPrice": {
              "$ref": "#/$defs/Money"
            }
          },
          "required": [
            "sku",
            "quantity",
            "unitPrice"
          ]
        },
        "Currency": {
          "type": "string",
          "description": "ISO 4217 currency code.",
          "enum": [
            "USD",
            "EUR",
            "CAD"
          ]
        }
      }
    },
    "mcp": {
      "enabled": false
    }
  }
}
